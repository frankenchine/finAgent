# Copy this file to application.yml and set your real api-key. Do not commit application.yml.
finagent:
  llm:
    # LLM provider: openai or deepseek
    provider: deepseek
    # Base URL for the LLM API
    # For OpenAI: https://api.openai.com/v1
    # For DeepSeek: https://api.deepseek.com/v1
    base-url: https://api.deepseek.com/v1
    # API key (set your key here or in application-local.yml; do not commit real keys)
    api-key: your-api-key-here
    # Model name
    # OpenAI: gpt-3.5-turbo, gpt-4, gpt-4-turbo-preview, etc.
    # DeepSeek: deepseek-chat, deepseek-coder, etc.
    model: deepseek-chat
    # Temperature (0.0 to 2.0)
    temperature: 0.7
    # Maximum tokens in the response
    max-tokens: 2000
    # Request timeout in seconds
    timeout-seconds: 60
